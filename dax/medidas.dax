// Medidas DAX do Painel E-Commerce & Macroeconomia Brasil.
//
// Este arquivo é uma consulta DAX completa: o bloco DEFINE declara todas as medidas do
// modelo (todas armazenadas na tabela Medidas) e o bloco EVALUATE no final retorna os
// indicadores executivos para conferência direta contra sql/gabarito/01_visao_executiva.csv.
//
// Regras de negócio aplicadas consistentemente (alinhadas a sql/02_views.sql e sql/consultas/):
//   - Todas as métricas comerciais, de frete, SLA, satisfação, pagamento, coorte e vendedores
//     consideram exclusivamente pedidos entregues (flag_entregue = 1).
//   - Pedidos não entregues (flag_entregue = 0) permanecem em fato_pedidos para rastreabilidade
//     de [Pedidos Brutos], [Pedidos Não Entregues] e [% Excluídos da Análise].
//   - % Entregas no Prazo usa como denominador apenas pedidos entregues com data_entrega_real
//     válida (96.470 pedidos, excluindo os 8 entregues sem data real).
//   - Valores reais (IPCA) estão em R$ constantes de out/2018 (BCB SGS 433).
//   - Pareto de categorias e decis de vendedores operam no grão de item (fato_itens_pedido)
//     para evitar dupla contagem em pedidos multi-categoria ou multi-vendedor.

DEFINE

// ---------------------------------------------------------------------------------------------
// 01. Receita, Volume & Macro

// Total de pedidos presentes na base bruta Olist (inclui cancelados e não entregues).
MEASURE Medidas[Pedidos Brutos] =
    COUNTROWS ( fato_pedidos )

// Pedidos efetivamente entregues ao cliente (status = delivered / flag_entregue = 1).
MEASURE Medidas[Pedidos Entregues] =
    CALCULATE (
        COUNTROWS ( fato_pedidos ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 )
    )

// Pedidos cancelados, indisponíveis ou em trânsito que não entram nas métricas comerciais.
MEASURE Medidas[Pedidos Não Entregues] =
    CALCULATE (
        COUNTROWS ( fato_pedidos ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 0 )
    )

// Participação dos pedidos não entregues sobre o total bruto Olist.
MEASURE Medidas[% Excluídos da Análise] =
    DIVIDE ( [Pedidos Não Entregues], [Pedidos Brutos] )

// Compradores únicos (customer_unique_id) com pelo menos um pedido entregue no contexto.
MEASURE Medidas[Clientes Únicos] =
    CALCULATE (
        DISTINCTCOUNT ( fato_pedidos[cliente_unico_id] ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 )
    )

// Soma de itens vendidos em pedidos entregues.
MEASURE Medidas[Itens Vendidos] =
    CALCULATE (
        SUM ( fato_pedidos[qtd_itens] ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 )
    )

// Média de itens por pedido entregue.
MEASURE Medidas[Itens por Pedido] =
    DIVIDE ( [Itens Vendidos], [Pedidos Entregues] )

// GMV nominal (produtos + frete) de pedidos entregues em R$ correntes da data da compra.
MEASURE Medidas[GMV Nominal] =
    CALCULATE (
        SUM ( fato_pedidos[valor_total_nominal] ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 )
    )

// GMV real deflacionado pelo IPCA acumulado (BCB SGS 433) em R$ constantes de out/2018.
MEASURE Medidas[GMV Real IPCA] =
    CALCULATE (
        SUM ( fato_pedidos[valor_total_real_ipca] ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 )
    )

// Receita nominal apenas de produtos (excluindo frete) em pedidos entregues.
MEASURE Medidas[Receita Produtos Nominal] =
    CALCULATE (
        SUM ( fato_pedidos[valor_produtos] ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 )
    )

// Soma nominal do frete cobrado em pedidos entregues.
MEASURE Medidas[Frete Nominal] =
    CALCULATE (
        SUM ( fato_pedidos[valor_frete] ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 )
    )

// Peso do frete no GMV nominal de pedidos entregues.
MEASURE Medidas[Frete % do GMV] =
    DIVIDE ( [Frete Nominal], [GMV Nominal] )

// Ticket médio nominal por pedido entregue (R$ correntes).
MEASURE Medidas[Ticket Médio Nominal] =
    DIVIDE ( [GMV Nominal], [Pedidos Entregues] )

// Ticket médio real por pedido entregue (R$ constantes de out/2018).
MEASURE Medidas[Ticket Médio Real] =
    DIVIDE ( [GMV Real IPCA], [Pedidos Entregues] )

// Variação mensal média do IPCA no período selecionado (BCB SGS 433).
MEASURE Medidas[IPCA Mensal %] =
    DIVIDE ( AVERAGE ( dim_macro_mensal[ipca_mensal_pct] ), 100 )

// IPCA acumulado em 12 meses médio no período selecionado (BCB SGS 433).
MEASURE Medidas[IPCA 12m %] =
    DIVIDE ( AVERAGE ( dim_macro_mensal[ipca_acum_12m_pct] ), 100 )

// Taxa Selic meta média mensal no período selecionado (BCB SGS 432, % a.a.).
MEASURE Medidas[Selic Média %] =
    DIVIDE ( AVERAGE ( dim_macro_mensal[selic_media] ), 100 )

// Cotação média mensal do dólar americano PTAX venda (BCB SGS 1, R$/US$).
MEASURE Medidas[Dólar PTAX Médio] =
    AVERAGE ( dim_macro_mensal[ptax_media] )

// Fator médio de deflação IPCA para base out/2018 (= 1,0000 em 2018-10).
MEASURE Medidas[Fator Deflator Médio] =
    AVERAGE ( dim_macro_mensal[fator_deflator] )

// ---------------------------------------------------------------------------------------------
// 02. Inteligência Temporal (Time Intelligence)

// GMV Real IPCA do mês imediatamente anterior no calendário.
MEASURE Medidas[GMV Real Mês Anterior] =
    CALCULATE (
        [GMV Real IPCA],
        DATEADD ( dim_calendario[data], -1, MONTH )
    )

// Variação mês contra mês (MoM %) do GMV Real IPCA quando ambos os meses possuem vendas.
MEASURE Medidas[GMV Real MoM %] =
    VAR Atual = [GMV Real IPCA]
    VAR Anterior = [GMV Real Mês Anterior]
    RETURN
        IF ( Atual > 0 && Anterior > 0, DIVIDE ( Atual - Anterior, Anterior ) )

// GMV Real IPCA do mesmo período no ano anterior.
MEASURE Medidas[GMV Real Ano Anterior] =
    CALCULATE (
        [GMV Real IPCA],
        SAMEPERIODLASTYEAR ( dim_calendario[data] )
    )

// Variação ano contra ano (YoY %) do GMV Real IPCA quando ambos os períodos possuem vendas.
MEASURE Medidas[GMV Real YoY %] =
    VAR Atual = [GMV Real IPCA]
    VAR Anterior = [GMV Real Ano Anterior]
    RETURN
        IF ( Atual > 0 && Anterior > 0, DIVIDE ( Atual - Anterior, Anterior ) )

// Média móvel de 3 meses do GMV Real IPCA (inclui meses com zero entregas como 0, igual ao SQL).
MEASURE Medidas[GMV Real Média Móvel 3m] =
    VAR DataMax = MAX ( dim_calendario[data] )
    VAR Janela = DATESINPERIOD ( dim_calendario[data], DataMax, -3, MONTH )
    RETURN
        AVERAGEX (
            CALCULATETABLE ( VALUES ( dim_calendario[ano_mes] ), Janela ),
            COALESCE ( [GMV Real IPCA], 0 )
        )

// GMV Real IPCA acumulado desde o início da série até a última data do contexto.
MEASURE Medidas[GMV Real Acumulado] =
    VAR DataMax = MAX ( dim_calendario[data] )
    RETURN
        CALCULATE (
            [GMV Real IPCA],
            FILTER ( ALL ( dim_calendario ), dim_calendario[data] <= DataMax )
        )

// Crescimento nominal homogêneo Jan–Ago 2018 vs Jan–Ago 2017 (evita viés da cauda parcial set–out/2018).
MEASURE Medidas[GMV Nominal YoY Jan-Ago %] =
    VAR Atual =
        CALCULATE (
            [GMV Nominal],
            dim_calendario[ano] = 2018,
            dim_calendario[mes] <= 8
        )
    VAR Anterior =
        CALCULATE (
            [GMV Nominal],
            dim_calendario[ano] = 2017,
            dim_calendario[mes] <= 8
        )
    RETURN
        IF ( Atual > 0 && Anterior > 0, DIVIDE ( Atual - Anterior, Anterior ) )

// Crescimento real (IPCA) homogêneo Jan–Ago 2018 vs Jan–Ago 2017.
MEASURE Medidas[GMV Real YoY Jan-Ago %] =
    VAR Atual =
        CALCULATE (
            [GMV Real IPCA],
            dim_calendario[ano] = 2018,
            dim_calendario[mes] <= 8
        )
    VAR Anterior =
        CALCULATE (
            [GMV Real IPCA],
            dim_calendario[ano] = 2017,
            dim_calendario[mes] <= 8
        )
    RETURN
        IF ( Atual > 0 && Anterior > 0, DIVIDE ( Atual - Anterior, Anterior ) )

// Crescimento de volume de pedidos entregues na janela homogênea Jan–Ago 2018 vs Jan–Ago 2017.
MEASURE Medidas[Pedidos YoY Jan-Ago %] =
    VAR Atual =
        CALCULATE (
            [Pedidos Entregues],
            dim_calendario[ano] = 2018,
            dim_calendario[mes] <= 8
        )
    VAR Anterior =
        CALCULATE (
            [Pedidos Entregues],
            dim_calendario[ano] = 2017,
            dim_calendario[mes] <= 8
        )
    RETURN
        IF ( Atual > 0 && Anterior > 0, DIVIDE ( Atual - Anterior, Anterior ) )

// Diferença em pontos percentuais entre crescimento nominal e real (Jan–Ago 2018 vs 2017).
MEASURE Medidas[Efeito Inflação YoY (p.p.)] =
    ( [GMV Nominal YoY Jan-Ago %] - [GMV Real YoY Jan-Ago %] ) * 100

// ---------------------------------------------------------------------------------------------
// 03. Logística, SLA & Impacto no Cliente

// Pedidos entregues que possuem timestamp real de entrega válido (denominador oficial do SLA).
MEASURE Medidas[Entregas com Data Válida] =
    CALCULATE (
        COUNTROWS ( fato_pedidos ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 ),
        KEEPFILTERS ( NOT ISBLANK ( fato_pedidos[data_entrega_real] ) )
    )

// Pedidos entregues até a data estimada informada ao cliente (flag_atraso == 0, exclui nulos).
MEASURE Medidas[Entregas no Prazo] =
    CALCULATE (
        COUNTROWS ( fato_pedidos ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 ),
        KEEPFILTERS ( NOT ISBLANK ( fato_pedidos[flag_atraso] ) ),
        KEEPFILTERS ( fato_pedidos[flag_atraso] == 0 )
    )

// Pedidos entregues após a data estimada (flag_atraso = 1).
MEASURE Medidas[Entregas Atrasadas] =
    CALCULATE (
        COUNTROWS ( fato_pedidos ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 ),
        KEEPFILTERS ( fato_pedidos[flag_atraso] = 1 )
    )

// Taxa de pontualidade logística (SLA): entregas no prazo sobre entregas com data real válida.
MEASURE Medidas[% Entregas no Prazo] =
    DIVIDE ( [Entregas no Prazo], [Entregas com Data Válida] )

// Prazo médio de entrega em dias corridos entre a data da compra e a entrega ao cliente.
MEASURE Medidas[Prazo Médio Entrega (d)] =
    CALCULATE (
        AVERAGE ( fato_pedidos[dias_entrega] ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 )
    )

// Média de dias de atraso considerando apenas pedidos entregues em atraso.
MEASURE Medidas[Atraso Médio quando Atrasa (d)] =
    CALCULATE (
        AVERAGE ( fato_pedidos[dias_atraso] ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 ),
        KEEPFILTERS ( fato_pedidos[flag_atraso] = 1 )
    )

// Nota média de avaliação do cliente (escala 1 a 5 estrelas) em pedidos entregues.
MEASURE Medidas[Nota Média] =
    CALCULATE (
        AVERAGE ( fato_pedidos[nota_review] ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 )
    )

// Nota média de avaliação em pedidos entregues dentro do prazo estimado (exclui nulos).
MEASURE Medidas[Nota Média no Prazo] =
    CALCULATE (
        AVERAGE ( fato_pedidos[nota_review] ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 ),
        KEEPFILTERS ( NOT ISBLANK ( fato_pedidos[flag_atraso] ) ),
        KEEPFILTERS ( fato_pedidos[flag_atraso] == 0 )
    )

// Nota média de avaliação em pedidos entregues com atraso.
MEASURE Medidas[Nota Média Atrasado] =
    CALCULATE (
        AVERAGE ( fato_pedidos[nota_review] ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 ),
        KEEPFILTERS ( fato_pedidos[flag_atraso] = 1 )
    )

// Queda na nota média provocada pelo atraso na entrega (Nota Atrasado - Nota no Prazo).
MEASURE Medidas[Impacto Atraso na Nota] =
    [Nota Média Atrasado] - [Nota Média no Prazo]

// População oficial IBGE (Estimativa 2018) somada sobre as UFs no contexto.
MEASURE Medidas[População IBGE] =
    SUM ( dim_geo_uf[populacao_ibge] )

// Penetração de e-commerce: GMV Real IPCA por 100 mil habitantes (IBGE 2018).
MEASURE Medidas[GMV Real / 100 mil hab.] =
    DIVIDE ( [GMV Real IPCA] * 100000, [População IBGE] )

// ---------------------------------------------------------------------------------------------
// 04. Comercial, Categorias, Pagamentos, Coorte & Vendedores

// GMV real (IPCA) somado no grão de item (fato_itens_pedido) para análises de categoria e vendedor.
MEASURE Medidas[GMV Itens Real IPCA] =
    CALCULATE (
        SUM ( fato_itens_pedido[valor_item_real_ipca] ),
        KEEPFILTERS ( fato_itens_pedido[flag_entregue] = 1 )
    )

// Participação de cada categoria no GMV real total de itens entregues.
MEASURE Medidas[% GMV Categorias] =
    DIVIDE (
        [GMV Itens Real IPCA],
        CALCULATE (
            [GMV Itens Real IPCA],
            ALL ( dim_categoria[categoria_codigo], dim_categoria[categoria_pt], dim_categoria[categoria_en] )
        )
    )

// Curva Pareto acumulada (% do GMV real) ordenada da maior categoria para a menor.
MEASURE Medidas[% Acumulado GMV Categorias] =
    VAR GmvAtual = [GMV Itens Real IPCA]
    VAR CatAtual = SELECTEDVALUE ( dim_categoria[categoria_pt] )
    VAR TotalCats =
        CALCULATE (
            [GMV Itens Real IPCA],
            ALL ( dim_categoria[categoria_codigo], dim_categoria[categoria_pt], dim_categoria[categoria_en] )
        )
    VAR Acumulado =
        SUMX (
            FILTER (
                ALL ( dim_categoria[categoria_pt] ),
                VAR GmvLinha = [GMV Itens Real IPCA]
                RETURN
                    GmvLinha > GmvAtual
                        || ( GmvLinha = GmvAtual && dim_categoria[categoria_pt] <= CatAtual )
            ),
            [GMV Itens Real IPCA]
        )
    RETURN
        IF ( NOT ISBLANK ( GmvAtual ), DIVIDE ( Acumulado, TotalCats ) )

// Participação de pedidos entregues pagos principalmente com cartão de crédito.
MEASURE Medidas[% Pedidos Cartão] =
    DIVIDE (
        CALCULATE (
            [Pedidos Entregues],
            KEEPFILTERS ( fato_pedidos[tipo_pagamento_principal] = "credit_card" )
        ),
        [Pedidos Entregues]
    )

// Participação de cada meio de pagamento no GMV real total entregue.
MEASURE Medidas[% GMV Pagamento] =
    DIVIDE (
        [GMV Real IPCA],
        CALCULATE (
            [GMV Real IPCA],
            ALL ( fato_pedidos[tipo_pagamento_principal], fato_pedidos[tipo_pagamento_pt] )
        )
    )

// Média de parcelas em pedidos entregues pagos com cartão de crédito (excluindo 0 parcelas).
MEASURE Medidas[Parcelas Médias (Cartão)] =
    CALCULATE (
        AVERAGE ( fato_pedidos[parcelas] ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 ),
        KEEPFILTERS ( fato_pedidos[tipo_pagamento_principal] = "credit_card" ),
        KEEPFILTERS ( fato_pedidos[parcelas] > 0 )
    )

// Percentual de pedidos no cartão de crédito pagos em 2 ou mais parcelas.
MEASURE Medidas[% Cartão Parcelado] =
    DIVIDE (
        CALCULATE (
            COUNTROWS ( fato_pedidos ),
            KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 ),
            KEEPFILTERS ( fato_pedidos[tipo_pagamento_principal] = "credit_card" ),
            KEEPFILTERS ( fato_pedidos[parcelas] > 1 )
        ),
        CALCULATE (
            COUNTROWS ( fato_pedidos ),
            KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 ),
            KEEPFILTERS ( fato_pedidos[tipo_pagamento_principal] = "credit_card" ),
            KEEPFILTERS ( fato_pedidos[parcelas] > 0 )
        )
    )

// Pedidos entregues pagos no cartão de crédito (usado na distribuição de parcelas).
MEASURE Medidas[Pedidos Cartão] =
    CALCULATE (
        [Pedidos Entregues],
        KEEPFILTERS ( fato_pedidos[tipo_pagamento_principal] = "credit_card" ),
        KEEPFILTERS ( fato_pedidos[parcelas] > 0 )
    )

// Clientes únicos entregues com 2 ou mais pedidos concluídos na base.
MEASURE Medidas[Clientes Recompra] =
    CALCULATE (
        DISTINCTCOUNT ( fato_pedidos[cliente_unico_id] ),
        KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 ),
        KEEPFILTERS ( fato_pedidos[flag_recompra] = 1 )
    )

// Taxa de recompra: percentual de clientes únicos que realizaram mais de um pedido entregue.
MEASURE Medidas[% Clientes Recompra] =
    DIVIDE ( [Clientes Recompra], [Clientes Únicos] )

// Retenção de coorte mensal: % dos clientes da coorte inicial que voltaram a comprar no mês M+n.
MEASURE Medidas[% Retenção Coorte] =
    VAR ClientesAtivos = [Clientes Únicos]
    VAR ClientesBase =
        CALCULATE (
            DISTINCTCOUNT ( fato_pedidos[cliente_unico_id] ),
            KEEPFILTERS ( fato_pedidos[flag_entregue] = 1 ),
            REMOVEFILTERS ( dim_calendario ),
            REMOVEFILTERS ( fato_pedidos[meses_desde_coorte], fato_pedidos[mes_coorte_label] ),
            fato_pedidos[meses_desde_coorte] = 0
        )
    RETURN
        IF ( NOT ISBLANK ( ClientesAtivos ), DIVIDE ( ClientesAtivos, ClientesBase ) )

// Quantidade de vendedores distintos com pelo menos um item entregue no contexto.
MEASURE Medidas[Vendedores Ativos] =
    CALCULATE (
        DISTINCTCOUNT ( fato_itens_pedido[seller_id] ),
        KEEPFILTERS ( fato_itens_pedido[flag_entregue] = 1 )
    )

// Participação de cada decil de vendedores no GMV real total entregue.
MEASURE Medidas[% GMV Vendedores] =
    DIVIDE (
        [GMV Itens Real IPCA],
        CALCULATE (
            [GMV Itens Real IPCA],
            ALL ( dim_vendedor[decil_gmv], dim_vendedor[decil_ordem] )
        )
    )

// Participação do decil D1 (top 10% vendedores) no GMV real entregue total.
MEASURE Medidas[% GMV Top 10% Vendedores] =
    DIVIDE (
        CALCULATE (
            [GMV Itens Real IPCA],
            dim_vendedor[decil_ordem] = 1
        ),
        CALCULATE (
            [GMV Itens Real IPCA],
            dim_vendedor[decil_ordem] >= 1 && dim_vendedor[decil_ordem] <= 10
        )
    )

// ---------------------------------------------------------------------------------------------
// 05. Qualidade & Auditoria

// Soma total de ocorrências detectadas nas 13 regras de auditoria de dados Olist.
MEASURE Medidas[Anomalias Detectadas] =
    SUM ( qualidade_auditoria[linhas_afetadas] )

// Quantidade de regras de qualidade monitoradas na tabela qualidade_auditoria.
MEASURE Medidas[Regras de Qualidade] =
    COUNTROWS ( qualidade_auditoria )

// Quantidade de avaliações duplicadas deduplicadas na limpeza (regra Q08).
MEASURE Medidas[Reviews Duplicadas] =
    CALCULATE (
        SUM ( qualidade_auditoria[linhas_afetadas] ),
        qualidade_auditoria[regra_id] = "Q08_AVALIACOES_DUPLICADAS"
    )

// Selo de conferência do gabarito SQL (6 de 6 consultas auditadas).
MEASURE Medidas[Selo Gabarito SQL] =
    "✓ 6/6"

// ---------------------------------------------------------------------------------------------
// 06. Subtítulos Dinâmicos (Deltas KPI) & Formatação Condicional

// Subtítulo dinâmico do cartão GMV Nominal (variação homogênea Jan–Ago 2018 vs 2017).
MEASURE Medidas[Delta GMV Nominal Texto] =
    VAR VarYoY = [GMV Nominal YoY Jan-Ago %]
    RETURN
        IF (
            ISBLANK ( VarYoY ),
            "R$ correntes (entregues)",
            IF ( VarYoY >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( VarYoY ), "0.0%" ) & " Jan–Ago 18/17"
        )

// Subtítulo dinâmico do cartão GMV Real IPCA (variação homogênea Jan–Ago 2018 vs 2017).
MEASURE Medidas[Delta GMV Real Texto] =
    VAR VarYoY = [GMV Real YoY Jan-Ago %]
    RETURN
        IF (
            ISBLANK ( VarYoY ),
            "R$ constantes out/2018",
            IF ( VarYoY >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( VarYoY ), "0.0%" ) & " Jan–Ago 18/17"
        )

// Subtítulo dinâmico do cartão Pedidos Entregues (variação homogênea Jan–Ago 2018 vs 2017).
MEASURE Medidas[Delta Pedidos Texto] =
    VAR VarYoY = [Pedidos YoY Jan-Ago %]
    RETURN
        IF (
            ISBLANK ( VarYoY ),
            "base entregue Olist",
            IF ( VarYoY >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( VarYoY ), "0.0%" ) & " Jan–Ago 18/17"
        )

// Cor semântica para deltas positivos de receita/volume (teal bom, coral ruim, muted neutro).
MEASURE Medidas[Cor Delta GMV Real] =
    VAR VarYoY = [GMV Real YoY Jan-Ago %]
    RETURN
        SWITCH (
            TRUE (),
            ISBLANK ( VarYoY ), "#64748B",
            VarYoY >= 0, "#0D9488",
            "#DC2626"
        )

// Cor de fonte condicional do % Entregas no Prazo na tabela de UFs (>=92% teal, <85% coral).
MEASURE Medidas[Cor SLA UF] =
    VAR Taxa = [% Entregas no Prazo]
    RETURN
        SWITCH (
            TRUE (),
            ISBLANK ( Taxa ), BLANK (),
            Taxa >= 0.92, "#0D9488",
            Taxa < 0.85, "#DC2626",
            "#334155"
        )

// Escala ordinal de cor das 5 faixas de atraso logístico (página 2, visual-herói).
MEASURE Medidas[Cor Faixa Atraso] =
    SWITCH (
        SELECTEDVALUE ( dim_faixa_atraso[ordem] ),
        1, "#0D9488",
        2, "#FCA5A5",
        3, "#F87171",
        4, "#DC2626",
        5, "#991B1B",
        "#94A3B8"
    )

// Escala de fundo branco -> teal para o mapa de calor da matriz de retenção de coorte (página 3).
MEASURE Medidas[Cor Retenção Coorte] =
    VAR Ret = [% Retenção Coorte]
    RETURN
        SWITCH (
            TRUE (),
            ISBLANK ( Ret ), "#FFFFFF",
            Ret >= 0.008, "#0D9488",
            Ret >= 0.005, "#2DD4BF",
            Ret >= 0.003, "#5EEAD4",
            Ret > 0, "#CCFBF1",
            "#FFFFFF"
        )

// Destaque de cor da matriz de concentração de vendedores (D1 coral, demais navy-300).
MEASURE Medidas[Cor Decil Vendedores] =
    IF ( SELECTEDVALUE ( dim_vendedor[decil_ordem] ) = 1, "#DC2626", "#A9BCD3" )

// Destaque de cor da distribuição de parcelas (1x navy, demais navy-300).
MEASURE Medidas[Cor Parcelas] =
    IF ( SELECTEDVALUE ( fato_pedidos[faixa_parcelas_ordem] ) = 1, "#1E3A5F", "#A9BCD3" )

// ---------------------------------------------------------------------------------------------
// Conferência executiva. Deve reproduzir exatamente sql/gabarito/01_visao_executiva.csv:
// 99.441 brutos, 96.478 entregues, R$ 15.424.463,65 nominal, R$ 15.964.483,56 real IPCA,
// ticket real R$ 165,47, nota 4,16 (4,29 no prazo vs 2,27 atrasado), prazo 12,50d, 93,23% no prazo,
// 75,48% cartão, 3,55 parcelas, 3,00% recompra, 66,34% top 10% vendedores.

EVALUATE
ROW (
    "Pedidos Brutos", [Pedidos Brutos],
    "Pedidos Entregues", [Pedidos Entregues],
    "Pedidos Não Entregues", [Pedidos Não Entregues],
    "% Excluídos", [% Excluídos da Análise],
    "GMV Nominal", [GMV Nominal],
    "GMV Real IPCA", [GMV Real IPCA],
    "Ticket Médio Real", [Ticket Médio Real],
    "Frete % do GMV", [Frete % do GMV],
    "Nota Média", [Nota Média],
    "Nota Média no Prazo", [Nota Média no Prazo],
    "Nota Média Atrasado", [Nota Média Atrasado],
    "Prazo Médio Entrega (d)", [Prazo Médio Entrega (d)],
    "% Entregas no Prazo", [% Entregas no Prazo],
    "Atraso Médio quando Atrasa (d)", [Atraso Médio quando Atrasa (d)],
    "GMV Real YoY Jan-Ago %", [GMV Real YoY Jan-Ago %],
    "GMV Nominal YoY Jan-Ago %", [GMV Nominal YoY Jan-Ago %],
    "% Pedidos Cartão", [% Pedidos Cartão],
    "Parcelas Médias (Cartão)", [Parcelas Médias (Cartão)],
    "% Cartão Parcelado", [% Cartão Parcelado],
    "% Clientes Recompra", [% Clientes Recompra],
    "% GMV Top 10% Vendedores", [% GMV Top 10% Vendedores],
    "Anomalias Detectadas", [Anomalias Detectadas],
    "Reviews Duplicadas", [Reviews Duplicadas]
)

# Gerado por marca/gerar.py (acento azul). Não edite à mão.
font.family: sans-serif
font.sans-serif: Segoe UI, Noto Sans, DejaVu Sans
font.size: 9
text.color: 1A1D21
axes.prop_cycle: cycler('color', ['2A6FD6', 'D2602C', '13917F', 'C98A00', 'B5427F'])
axes.facecolor: FFFFFF
axes.edgecolor: C4C9D0
axes.labelcolor: 4A515A
axes.titlesize: 11
axes.titleweight: 600
axes.titlelocation: left
axes.titlepad: 10
axes.titlecolor: 1A1D21
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.spines.bottom: True
axes.linewidth: 1
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
grid.color: EBEDF0
grid.linewidth: 1
grid.linestyle: -
xtick.color: 5C636D
ytick.color: 5C636D
xtick.labelcolor: 5C636D
ytick.labelcolor: 5C636D
xtick.major.size: 0
ytick.major.size: 0
xtick.major.pad: 6
ytick.major.pad: 6
lines.linewidth: 2
lines.solid_capstyle: round
lines.solid_joinstyle: round
legend.frameon: False
legend.fontsize: 9
figure.facecolor: FFFFFF
figure.dpi: 150
savefig.dpi: 200
savefig.facecolor: FFFFFF
savefig.bbox: tight

	partition fato_pedidos = m
		mode: import
		source =
				let
				    Fonte = fn_LerCsv("fato_pedidos.csv"),
				    Selecionadas = Table.SelectColumns(Fonte, {"order_id", "data_compra", "ano_mes", "data_aprovacao", "data_entrega_estimada", "data_entrega_real", "dias_entrega", "dias_atraso", "flag_atraso", "faixa_atraso", "status", "flag_entregue", "uf_cliente", "categoria_principal", "nota_review", "qtd_itens", "valor_produtos", "valor_frete", "valor_total_nominal", "valor_total_real_ipca", "tipo_pagamento_principal", "parcelas", "cliente_unico_id", "coorte_mes", "meses_desde_coorte", "flag_recompra", "flag_frete_outlier"}),
				    Nulos = Table.ReplaceValue(Selecionadas, "", null, Replacer.ReplaceValue, {"order_id", "data_compra", "ano_mes", "data_aprovacao", "data_entrega_estimada", "data_entrega_real", "dias_entrega", "dias_atraso", "flag_atraso", "faixa_atraso", "status", "flag_entregue", "uf_cliente", "categoria_principal", "nota_review", "qtd_itens", "valor_produtos", "valor_frete", "valor_total_nominal", "valor_total_real_ipca", "tipo_pagamento_principal", "parcelas", "cliente_unico_id", "coorte_mes", "meses_desde_coorte", "flag_recompra", "flag_frete_outlier"}),
				    Tipada = Table.TransformColumnTypes(Nulos, {{"order_id", type text}, {"data_compra", type date}, {"ano_mes", type text}, {"data_aprovacao", type date}, {"data_entrega_estimada", type date}, {"data_entrega_real", type date}, {"dias_entrega", Int64.Type}, {"dias_atraso", Int64.Type}, {"flag_atraso", Int64.Type}, {"faixa_atraso", type text}, {"status", type text}, {"flag_entregue", Int64.Type}, {"uf_cliente", type text}, {"categoria_principal", type text}, {"nota_review", Int64.Type}, {"qtd_itens", Int64.Type}, {"valor_produtos", type number}, {"valor_frete", type number}, {"valor_total_nominal", type number}, {"valor_total_real_ipca", type number}, {"tipo_pagamento_principal", type text}, {"parcelas", Int64.Type}, {"cliente_unico_id", type text}, {"coorte_mes", type text}, {"meses_desde_coorte", Int64.Type}, {"flag_recompra", Int64.Type}, {"flag_frete_outlier", Int64.Type}}, "en-US"),
				    ComPagamentoPt = Table.AddColumn(Tipada, "tipo_pagamento_pt", each if [tipo_pagamento_principal] = "credit_card" then "Cartão de crédito" else if [tipo_pagamento_principal] = "boleto" then "Boleto bancário" else if [tipo_pagamento_principal] = "voucher" then "Voucher e cupom" else if [tipo_pagamento_principal] = "debit_card" then "Cartão de débito" else if [tipo_pagamento_principal] = "not_defined" then "Não definido" else "Sem registro", type text),
				    ComParcelasOrdem = Table.AddColumn(ComPagamentoPt, "faixa_parcelas_ordem", each if [parcelas] = null or [parcelas] <= 0 then 0 else if [parcelas] >= 10 then 10 else [parcelas], Int64.Type),
				    ComFaixaParcelas = Table.AddColumn(ComParcelasOrdem, "faixa_parcelas", each if [faixa_parcelas_ordem] = 0 then "Sem info" else if [faixa_parcelas_ordem] = 10 then "10x+" else Text.From([faixa_parcelas_ordem]) & "x", type text),
				    ComCoorteLabel = Table.AddColumn(ComFaixaParcelas, "mes_coorte_label", each if [meses_desde_coorte] = 0 then "M0" else "M+" & Text.From([meses_desde_coorte]), type text),
				    ComCoorteNum = Table.AddColumn(ComCoorteLabel, "coorte_mes_num", each Int64.From(Text.Replace([coorte_mes], "-", "")), Int64.Type)
				in
				    ComCoorteNum

	annotation PBI_ResultType = Table

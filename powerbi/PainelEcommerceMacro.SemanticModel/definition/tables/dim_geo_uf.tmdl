	partition dim_geo_uf = m
		mode: import
		source =
				let
				    Fonte = fn_LerCsv("dim_geo_uf.csv"),
				    Selecionadas = Table.SelectColumns(Fonte, {"uf", "codigo_ibge", "nome", "regiao_sigla", "regiao", "populacao_ibge", "populacao_censo_2022"}),
				    Nulos = Table.ReplaceValue(Selecionadas, "", null, Replacer.ReplaceValue, {"uf", "codigo_ibge", "nome", "regiao_sigla", "regiao", "populacao_ibge", "populacao_censo_2022"}),
				    Tipada = Table.TransformColumnTypes(Nulos, {{"uf", type text}, {"codigo_ibge", Int64.Type}, {"nome", type text}, {"regiao_sigla", type text}, {"regiao", type text}, {"populacao_ibge", Int64.Type}, {"populacao_censo_2022", Int64.Type}}, "en-US")
				in
				    Tipada

	annotation PBI_ResultType = Table

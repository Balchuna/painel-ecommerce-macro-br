/// Auditoria das 13 anomalias reais detectadas na base Olist e seu tratamento.
table qualidade_auditoria
	lineageTag: 2674c287-f358-5782-ab19-eb829c35e801

	column regra_id
		dataType: string
		lineageTag: b05e694b-2fe4-5fe9-8d2a-03a13af83f27
		summarizeBy: none
		sourceColumn: regra_id

		annotation SummarizationSetBy = User

	column regra
		dataType: string
		lineageTag: b65b80a2-6b4d-5da7-b2e7-5199643df0c2
		summarizeBy: none
		sourceColumn: regra

		annotation SummarizationSetBy = User

	column regra_en
		dataType: string
		lineageTag: ecd7d5d0-ed62-5d20-b01a-6589f78a0f76
		summarizeBy: none
		sourceColumn: regra_en

		annotation SummarizationSetBy = User

	column tabela_origem
		dataType: string
		lineageTag: f7cbcbcb-5f16-5aaa-bb1f-58ce76c8b369
		summarizeBy: none
		sourceColumn: tabela_origem

		annotation SummarizationSetBy = User

	column linhas_afetadas
		dataType: int64
		formatString: #,0
		lineageTag: 1e09f708-d932-5540-8310-a533a7aa7156
		summarizeBy: none
		sourceColumn: linhas_afetadas

		annotation SummarizationSetBy = User

	column base_referencia
		dataType: int64
		formatString: 0
		lineageTag: 8de3bbcc-20ea-50c0-9d17-dabc3420c1bf
		summarizeBy: none
		sourceColumn: base_referencia

		annotation SummarizationSetBy = User

	column pct_base
		dataType: double
		lineageTag: 89a78e40-c6ec-5489-bf58-b716332dbadd
		summarizeBy: none
		sourceColumn: pct_base

		annotation SummarizationSetBy = User

	column severidade
		dataType: string
		lineageTag: ef652808-5ed7-5d64-b16a-88477ec27ae1
		summarizeBy: none
		sourceColumn: severidade

		annotation SummarizationSetBy = User

	column tratamento
		dataType: string
		lineageTag: 3118ba71-1548-5ed9-b4cf-857747e58245
		summarizeBy: none
		sourceColumn: tratamento

		annotation SummarizationSetBy = User

	column tratamento_en
		dataType: string
		lineageTag: d20b6bae-1b13-5fa0-8bdc-dec9910cc2d4
		summarizeBy: none
		sourceColumn: tratamento_en

		annotation SummarizationSetBy = User

	column pct_base_frac
		dataType: double
		formatString: 0.00%
		lineageTag: dc93d910-cc8c-59b4-ba8b-afa47116786d
		summarizeBy: none
		sourceColumn: pct_base_frac

		annotation SummarizationSetBy = User

	column tabela_curta
		dataType: string
		lineageTag: 4415921f-703f-5139-a053-c23fd20393a3
		summarizeBy: none
		sourceColumn: tabela_curta

		annotation SummarizationSetBy = User

	column tipo_curto
		dataType: string
		lineageTag: 382b7f12-db3e-58e5-9c7f-494ca0273f38
		summarizeBy: none
		sourceColumn: tipo_curto

		annotation SummarizationSetBy = User

	partition qualidade_auditoria = m
		mode: import
		source =
				let
				    Fonte = fn_LerCsv("qualidade_auditoria.csv"),
				    Selecionadas = Table.SelectColumns(Fonte, {"regra_id", "regra", "regra_en", "tabela_origem", "linhas_afetadas", "base_referencia", "pct_base", "severidade", "tratamento", "tratamento_en"}),
				    Nulos = Table.ReplaceValue(Selecionadas, "", null, Replacer.ReplaceValue, {"regra_id", "regra", "regra_en", "tabela_origem", "linhas_afetadas", "base_referencia", "pct_base", "severidade", "tratamento", "tratamento_en"}),
				    Tipada = Table.TransformColumnTypes(Nulos, {{"regra_id", type text}, {"regra", type text}, {"regra_en", type text}, {"tabela_origem", type text}, {"linhas_afetadas", Int64.Type}, {"base_referencia", Int64.Type}, {"pct_base", type number}, {"severidade", type text}, {"tratamento", type text}, {"tratamento_en", type text}}, "en-US"),
				    ComPctFrac = Table.AddColumn(Tipada, "pct_base_frac", each [pct_base] / 100.0, type number),
				    ComTabelaCurta = Table.AddColumn(ComPctFrac, "tabela_curta", each Text.Replace(Text.Replace(Text.Replace([tabela_origem], "olist_", ""), "_dataset", ""), "product_category_name_translation.csv", "cat_translation.csv"), type text),
				    ComTipoCurto = Table.AddColumn(ComTabelaCurta, "tipo_curto", each if Text.Contains([severidade], "parcial") then "Exclusão SLA" else if Text.Contains([severidade], "Exclus") then "Exclusão" else if Text.Contains([severidade], "Deduplic") then "Deduplicação" else if Text.Contains([severidade], "Fallback") then "Fallback" else if Text.Contains([severidade], "Limpeza") then "Limpeza" else "Sinalização", type text)
				in
				    ComTipoCurto

	annotation PBI_ResultType = Table
